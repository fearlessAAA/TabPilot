# Copy to .env (git-ignored). `tabpilot` reads it from the repository root.

# Prior Labs API key for downloading the TabPFN v3.5 weights: log in at https://ux.priorlabs.ai,
# accept the license and copy the key from the account page.
TABPFN_TOKEN=

# DeepSeek API key for TopBench's answer judge, used by `tabpilot evaluate`.
DEEPSEEK_API_KEY=

# Optional: run the judge through another OpenAI-compatible provider serving DeepSeek-V3.2.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_JUDGE_MODEL_ID=deepseek-chat
